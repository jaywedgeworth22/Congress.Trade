[Unit]
Description=Congress.Trade health recover (auto-restart on public /api/health failure)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/congress-health-recover.sh
Restart=always
RestartSec=15
SyslogIdentifier=congress-health-recover
# Optional: EnvironmentFile=-/etc/congress-health-recover.env
# (set COOLIFY_TOKEN there if you also want Coolify API restarts)

[Install]
WantedBy=multi-user.target
