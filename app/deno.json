{
  "unstable": [
    "kv",
    "cron"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "src/__tests__",
    "**/*.test.ts"
  ],
  "tasks": {
    "start": "deno run --unstable-kv --unstable-cron --allow-net --allow-env --allow-read src/deno/main.ts"
  },
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "imports": {
    "@jaywedgeworth22/congress-trading-shared": "./shared.ts"
  }
}
