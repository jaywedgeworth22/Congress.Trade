{
  "name": "congress-feed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers service ingesting US congressional STOCK Act stock-trade disclosures (House + Senate) and pushing structured trade events to clients.",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:full": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "preview:provision": "bash scripts/provision-preview.sh",
    "preview:deploy": "bash scripts/deploy-preview.sh"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.6.0",
    "node-html-parser": "^7.1.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
