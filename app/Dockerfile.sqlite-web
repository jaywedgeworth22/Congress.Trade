FROM python:3.9-alpine

RUN pip install sqlite-web

EXPOSE 8080

# sqlite-web --password reads SQLITE_WEB_PASSWORD from the environment when set.
# If the env is empty it falls back to interactive getpass(), which EOFErrors in
# Docker (no TTY) and crash-loops with restart:unless-stopped. That restart storm
# can flip Coolify's multi-service app status to exited:unhealthy and take down
# congress-app (502 on congress.trade). Require the env and fail once if missing.
CMD ["sh", "-c", "if [ -z \"${SQLITE_WEB_PASSWORD:-}\" ]; then echo 'FATAL: SQLITE_WEB_PASSWORD is empty; set it in Coolify env (loopback admin UI).' >&2; exit 1; fi; exec sqlite_web -x --password -H 0.0.0.0 /data/congress-trade/db.sqlite"]
