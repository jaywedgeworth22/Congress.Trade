# Copy to `.dev.vars` for local development (`wrangler dev`).
# `.dev.vars` is gitignored — never commit real secrets.
#
# ── SINGLE SOURCE OF TRUTH: INFISICAL ───────────────────────────────────────
# Every key/knob below (except the INFISICAL_* bootstrap credentials and the
# SENTRY_* init vars) is resolved at runtime through the Infisical resolver:
# the Infisical value ALWAYS wins; values in this file are only fallbacks for
# keyless/offline local dev. The preferred local setup is MINIMAL: fill in just
# the INFISICAL_* bootstrap block and leave everything else blank — wrangler
# dev will then pull live config from Infisical exactly like production does.
# Full key registry: app/docs/config-registry.md; live per-key source audit:
# GET /api/admin/config-sources.

# Infisical runtime secret resolver. In production, Cloudflare should only need
# these bootstrap machine-identity credentials; provider/app secrets are fetched
# from Infisical at runtime and cached briefly in Worker memory.
INFISICAL_BASE_URL="https://app.infisical.com"
INFISICAL_ENV="prod"
INFISICAL_CACHE_TTL_SECONDS="600"
# Keep "true" during migration so existing Worker secrets remain a compatibility
# fallback. Set to "false" after Infisical runtime resolution is verified.
INFISICAL_ALLOW_ENV_FALLBACK="true"
INFISICAL_APP_PROJECT_ID=""
INFISICAL_APP_CLIENT_ID=""
INFISICAL_APP_CLIENT_SECRET=""
INFISICAL_APP_SECRET_PATH="/"
INFISICAL_SHARED_PROJECT_ID=""
INFISICAL_SHARED_CLIENT_ID=""
INFISICAL_SHARED_CLIENT_SECRET=""
INFISICAL_SHARED_SECRET_PATH="/"

# Vision/LLM extraction for scanned PDFs (Google Gemini).
GEMINI_API_KEY=""
# Primary vision model override (defaults to 'gemini-3.5-flash').
VISION_PRIMARY_MODEL=""
# Optional extractor bake-off candidates used by /api/admin/extractor-bakeoff.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
MISTRAL_API_KEY=""
# LlamaIndex Cloud (LlamaParse) — OCR + handwriting-aware structured extraction.
# Get a key at https://cloud.llamaindex.ai. Free tier: 10,000 credits/month.
# Use as agreement model: AGREEMENT_AUTOPUBLISH_MODEL_B="llamaparse:cost-effective"
# Tiers (credits/page): fast=1, cost-effective=3, agentic=10, agentic-plus=45

# Autonomous review-resolution cascade. Keep A/B/C on distinct vendors; model
# C is Anthropic because the production Worker has ANTHROPIC_API_KEY configured.
AGREEMENT_AUTOPUBLISH_ENABLED="true"
AGREEMENT_AUTOPUBLISH_MODEL_A="mistral:mistral-ocr-latest"
AGREEMENT_AUTOPUBLISH_MODEL_B="openai:gpt-4o"
AGREEMENT_MODEL_C="anthropic:claude-sonnet-4-6"
AGREEMENT_AUTOPUBLISH_LIMIT="3"
AGREEMENT_MAX_ATTEMPTS="3"
# One model reading one doc = one read. This caps autonomous work only; the
# operator-triggered POST /api/admin/agreement-reprocess remains uncapped. Use
# -1 explicitly for unlimited. Backed by llm_budget (migration 0032).
AGREEMENT_DAILY_LLM_BUDGET="300"
# Large documents start with all three vendors instead of spending an A/B pass
# first. A document is large when either threshold is exceeded.
AGREEMENT_BIG_DOC_START_TIER2="true"
AGREEMENT_BIG_DOC_PAGE_THRESHOLD="10"
AGREEMENT_BIG_DOC_BYTES_THRESHOLD="2097152"

# Financial Modeling Prep — enables asset enrichment (sector, market cap, country,
# exchange) and, later, price + performance-vs-S&P. Without it, the SEC-EDGAR
# free fallback still fills a subset and the rest shows "—". Rate limit is per
# key (not per IP), so a dedicated key here is isolated from other apps.
FMP_API_KEY=""
# Daily FMP call budget (the enrichment job spends today's needs first, then
# backfills history with the remainder). Defaults to 230 when unset.
FMP_DAILY_CALL_CAP=""

# Optional additional market-data fallback provider (enrichment chain + price
# history, PRICE_PROVIDER="tiingo"). Unused unless this key is set. Free-tier
# key at https://api.tiingo.com.
TIINGO_API_KEY=""

# Secondary extractor / arbitration provider key. When set, buildExtractorPipeline
# builds a second, independent vision extractor; with ARBITRATION_ENABLED="true"
# it cross-checks every scanned doc and ArbitratingExtractor merges the results.
ARBITRATION_API_KEY=""
# "true" to actually run the secondary + arbitration when a key is present.
ARBITRATION_ENABLED=""
# Model id for the secondary vision extractor (default: gemini-2.5-flash).
ARBITRATION_MODEL=""

# HMAC key used to sign outbound webhook payloads (X-Signature header).
WEBHOOK_SIGNING_KEY=""

# Admin API bearer token. When set, /api/admin/* accepts a request carrying
# `Authorization: Bearer <ADMIN_TOKEN>` (good for curl / cron / automation).
# The admin API fails closed when no bearer token or Cloudflare Access config is
# present. For local dev only, set ADMIN_OPEN_IN_DEV="true" to open it.
ADMIN_TOKEN=""
ADMIN_OPEN_IN_DEV=""
# Scoped token that authorizes only POST /api/admin/securities/import for
# cross-app FMP data sharing. Prefer this over ADMIN_TOKEN in sibling apps.
INGEST_TOKEN=""
# Scoped token that authorizes ONLY the idempotent maintenance endpoints
# (ingest-requeue-failed / ingest-retry-errored). Prefer this over ADMIN_TOKEN
# for agent/automation sessions that run backlog drains.
ADMIN_MAINTENANCE_TOKEN=""

# Return half of the cross-app share (Congress.Trade -> sibling app). After the
# daily refresh, the prices/refs WE fetched this run are POSTed to the sibling
# app's /securities/import (its scoped ingest token). No-op unless BOTH are set.
# We only send our own fetches, so data the sibling sent us is never echoed back.
APP_B_IMPORT_URL=""
APP_B_INGEST_TOKEN=""

# API Usage Monitor app telemetry. Set USAGE_MONITOR_INGEST_TOKEN to the
# monitor's USAGE_INGEST_TOKEN. No-op unless URL + token are both configured.
USAGE_MONITOR_INGEST_URL="https://usage.jays.services/api/ingest/usage"
USAGE_MONITOR_INGEST_TOKEN=""
USAGE_MONITOR_ENVIRONMENT="local"
USAGE_MONITOR_ENABLED=""

# Cross-app import guardrails. Production wrangler.toml uses paid-plan defaults.
# Lower these values to run a lean/free-compatible profile while keeping the
# same code path and smaller upstream chunks.
IMPORT_MAX_BYTES="1500000"
IMPORT_MAX_REFS="2000"
IMPORT_MAX_SPX="5000"
IMPORT_MAX_PRICES="100"
IMPORT_MAX_CLOSES_PER_TICKER="1500"
IMPORT_MAX_INSIDER="5000"
IMPORT_MAX_SHORT_VOLUME="5000"

# Optional disclosure-latency benchmark: polls third-party latest-disclosure
# endpoints and records whether Congress.Trade saw new filings first.
# Supported direct providers: fmp, unusual_whales, quiver. Finnhub and AInvest
# are symbol-scoped and Capitol Trades has no stable server API, so those are
# reported in admin provider status but not automatically probed.
# Turn on before waiting for the next new disclosures; default code path is off.
DISCLOSURE_LATENCY_WATCH_ENABLED=""
DISCLOSURE_LATENCY_PROVIDERS="fmp,unusual_whales,quiver"
DISCLOSURE_LATENCY_WATCH_LIMIT="100"
FMP_DISCLOSURE_WATCH_ENABLED=""
FMP_DISCLOSURE_WATCH_LIMIT="100"
# Optional provider credentials are resolved from .dev.vars or Worker secrets
# when those providers are enabled: Unusual Whales, Quiver, and AInvest.

# Cloudflare Access (Zero Trust) sign-in for humans — an ALTERNATIVE/ADDITION to
# the bearer token. With these set AND an Access application fronting
# /api/admin/*, a request is authorized when its `Cf-Access-Jwt-Assertion` JWT
# verifies against the team keys, its `aud` equals ACCESS_AUD, and its
# authenticated email is on ADMIN_EMAILS. A request is admitted if EITHER the
# token OR a verified Access email matches; the surface is open only when
# NEITHER mechanism is configured.
#   ADMIN_EMAILS        — comma/space-separated allowlist, e.g. "a@x.com, b@x.com"
#   ACCESS_AUD          — the Access application's Audience (AUD) tag
#   ACCESS_TEAM_DOMAIN  — team name ("myteam") or host ("myteam.cloudflareaccess.com")
ADMIN_EMAILS=""
ACCESS_AUD=""
ACCESS_TEAM_DOMAIN=""

# Historic-backfill source overrides. Senate defaults to a working GitHub mirror
# (no override needed). The community House S3 bucket is gated (HTTP 403) — set
# SEED_HOUSE_URL to a mirror, OR use the official House index backfill instead
# (POST /api/admin/backfill/house-index), which needs no override.
SEED_HOUSE_URL=""
SEED_SENATE_URL=""

# Set to "false" to disable the intraday House live-search overlay (the watcher
# falls back to the daily bulk-XML diff, which is always used regardless).
HOUSE_LIVE_SEARCH_ENABLED=""

# End-user sign-in (public site). Google OAuth + email magic-link.
#   - GOOGLE_OAUTH_CLIENT_ID / _SECRET: from Google Cloud console (OAuth 2.0
#     client). Authorized redirect URI: <APP_BASE_URL>/auth/google/callback
#   - RESEND_API_KEY + EMAIL_FROM: transactional email for magic links
#     (EMAIL_FROM must be a verified Resend sender, e.g. "Congress.Trade <login@congress.trade>")
#   - APP_BASE_URL: public origin used to build OAuth redirects + magic links
#     (e.g. https://congress.trade). Falls back to the request origin if unset.
# Sessions + magic tokens live in CONFIG_KV (TTL-managed); no extra binding needed.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM=""
APP_BASE_URL=""

# Operational alerts. If set (and RESEND_API_KEY + EMAIL_FROM are configured),
# the daily job emails this address when FMP enrichment/price refresh fails with
# key/plan errors (401/402/403/429) — i.e. the paid tier stopped working.
# Throttled to at most one alert per 12h.
ALERT_EMAIL=""

# Sentry error monitoring (Cloudflare Workers SDK).
# Get this from Sentry → Projects → congress-trade → Settings → Client Keys (DSN).
SENTRY_DSN=""
# Tags events/logs with this environment. Defaults to unset in local dev; the
# production/preview values are already set as wrangler.toml [vars].
SENTRY_ENVIRONMENT="development"

# Billing (Stripe) — freemium paywall. Premium unlocks full history + CSV export.
#   - STRIPE_SECRET_KEY: sk_live_… / sk_test_… (enables billing; absent => 503)
#   - STRIPE_WEBHOOK_SECRET: whsec_… from the webhook endpoint you create for
#     <APP_BASE_URL>/billing/webhook (events: checkout.session.completed,
#     customer.subscription.created/updated/deleted)
#   - STRIPE_PRICE_MONTHLY / _ANNUAL: recurring Price ids (price_…) for the
#     $15/mo and $140/yr premium tier
#   - STRIPE_TRIAL_DAYS: free-trial length for new subscriptions (default 7)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
STRIPE_TRIAL_DAYS="7"

# Public-API anti-scraping guard. wrangler.toml [vars] turns it on for
# production AND local `wrangler dev`; set "false" here if you need plain
# curl/scripts against local /api/* data endpoints (or send a browser UA).
SCRAPE_GUARD_ENABLED="true"

# Executive-branch (OGE Form 278-T) filings watcher — Presidential trades.
# Polls the OGE President/VP index (~6h, fail-soft); rows land as
# chamber='executive' and stay OUT of the default feed/analytics until the
# Executive chip / chamber filter opts in. Filings over OGE_MAX_VISION_BYTES
# (default 6MB) route straight to review instead of vision extraction.
OGE_WATCH_ENABLED="true"
OGE_INDEX_URL=""
OGE_POLL_INTERVAL_SEC="21600"
OGE_MAX_VISION_BYTES="6000000"
