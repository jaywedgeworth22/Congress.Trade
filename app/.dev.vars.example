# Copy to `.dev.vars` for local development (`wrangler dev`).
# `.dev.vars` is gitignored — never commit real secrets.

# Vision/LLM extraction for scanned PDFs (Google Gemini).
GEMINI_API_KEY=""

# Secondary extractor / arbitration provider key. When set, buildExtractorPipeline
# builds a second, independent vision extractor; with ARBITRATION_ENABLED="true"
# it cross-checks every scanned doc and ArbitratingExtractor merges the results.
ARBITRATION_API_KEY=""
# "true" to actually run the secondary + arbitration when a key is present.
ARBITRATION_ENABLED=""
# Model id for the secondary vision extractor (default: gemini-2.5-flash).
ARBITRATION_MODEL=""

# HMAC key used to sign outbound webhook payloads (X-Signature header).
WEBHOOK_SIGNING_KEY=""

# Admin API bearer token. When set, /api/admin/* accepts a request carrying
# `Authorization: Bearer <ADMIN_TOKEN>` (good for curl / cron / automation).
# Leave unset for open local dev (a one-time warning is logged).
ADMIN_TOKEN=""

# Cloudflare Access (Zero Trust) sign-in for humans — an ALTERNATIVE/ADDITION to
# the bearer token. With these set AND an Access application fronting
# /api/admin/*, a request is authorized when its `Cf-Access-Jwt-Assertion` JWT
# verifies against the team keys, its `aud` equals ACCESS_AUD, and its
# authenticated email is on ADMIN_EMAILS. A request is admitted if EITHER the
# token OR a verified Access email matches; the surface is open only when
# NEITHER mechanism is configured.
#   ADMIN_EMAILS        — comma/space-separated allowlist, e.g. "a@x.com, b@x.com"
#   ACCESS_AUD          — the Access application's Audience (AUD) tag
#   ACCESS_TEAM_DOMAIN  — team name ("myteam") or host ("myteam.cloudflareaccess.com")
ADMIN_EMAILS=""
ACCESS_AUD=""
ACCESS_TEAM_DOMAIN=""

# Historic-backfill source overrides. Senate defaults to a working GitHub mirror
# (no override needed). The community House S3 bucket is gated (HTTP 403) — set
# SEED_HOUSE_URL to a mirror, OR use the official House index backfill instead
# (POST /api/admin/backfill/house-index), which needs no override.
SEED_HOUSE_URL=""
SEED_SENATE_URL=""

# Set to "false" to disable the intraday House live-search overlay (the watcher
# falls back to the daily bulk-XML diff, which is always used regardless).
HOUSE_LIVE_SEARCH_ENABLED=""

# End-user sign-in (public site). Google OAuth + email magic-link.
#   - GOOGLE_OAUTH_CLIENT_ID / _SECRET: from Google Cloud console (OAuth 2.0
#     client). Authorized redirect URI: <APP_BASE_URL>/auth/google/callback
#   - RESEND_API_KEY + EMAIL_FROM: transactional email for magic links
#     (EMAIL_FROM must be a verified Resend sender, e.g. "Congress.Trade <login@congress.trade>")
#   - APP_BASE_URL: public origin used to build OAuth redirects + magic links
#     (e.g. https://congress.trade). Falls back to the request origin if unset.
# Sessions + magic tokens live in CONFIG_KV (TTL-managed); no extra binding needed.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM=""
APP_BASE_URL=""

# Billing (Stripe) — freemium paywall. Premium unlocks full history + CSV export.
#   - STRIPE_SECRET_KEY: sk_live_… / sk_test_… (enables billing; absent => 503)
#   - STRIPE_WEBHOOK_SECRET: whsec_… from the webhook endpoint you create for
#     <APP_BASE_URL>/billing/webhook (events: checkout.session.completed,
#     customer.subscription.created/updated/deleted)
#   - STRIPE_PRICE_MONTHLY / _ANNUAL: recurring Price ids (price_…) for the
#     $15/mo and $140/yr premium tier
#   - STRIPE_TRIAL_DAYS: free-trial length for new subscriptions (default 7)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
STRIPE_TRIAL_DAYS="7"
